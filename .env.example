# Database
DATABASE_URL=postgresql+asyncpg://asama_user:asama_pass@localhost:5432/asama_network
DATABASE_URL_SYNC=postgresql://asama_user:asama_pass@localhost:5432/asama_network

# Redis (Event Streaming)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Celery Broker)
CELERY_BROKER_URL=amqp://asama:asama_pass@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# OpenAI (Embeddings)
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536

# Cohere (Reranking)
COHERE_API_KEY=your-cohere-api-key-here

# Routing Engine
ANN_TOP_K=50
RERANK_THRESHOLD=0.75

# Webhook Security
WEBHOOK_HMAC_SECRET=your-hmac-secret-key-here

# Guardrails (set to "llama_guard" if Ollama + Llama Guard available, else "rule_based")
GUARDRAIL_MODE=rule_based
